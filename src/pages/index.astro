---
import ArticleRow from "../components/ArticleRow.astro";
import DomainCard from "../components/DomainCard.astro";
import SearchBox from "../components/SearchBox.astro";
import { articles } from "../data/articles";
import { domains } from "../data/domains";
import homepageVideo from "../Assets/videos/video-1.mp4";
import BaseLayout from "../layouts/BaseLayout.astro";

const homepageArticles = articles.slice(0, 6);
const moreHomepageArticles = articles.slice(6, 12);
const homepageDomains = domains.slice(0, 3);
---

<BaseLayout
  title="Overstudied"
  description="Deep technical notes, architecture explainers, and focused study domains."
>
  <main id="main-content" class="home-page">
    <div class="home-hero__media">
      <video
        src={homepageVideo}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
        data-homepage-video
      ></video>
      <div class="home-hero__copy">
        <h1>Become disgustingly over educated</h1>
        <p>
          Study the ideas everyone skips, connect them across systems, and build understanding that compounds.
        </p>
        <div class="home-hero__actions" aria-label="Explore Overstudied content">
          <a class="home-hero__button home-hero__button--primary" href="/domains">Explore Domains</a>
          <a class="home-hero__button home-hero__button--secondary" href="/articles">Articles</a>
        </div>
      </div>
    </div>

    <div class="page-shell home-page__content">
      <div class="page-search">
        <SearchBox id="content-search" placeholder="Search articles" />
      </div>

      <section class="home-section" aria-labelledby="home-articles-title">
        <header class="home-section__header">
          <h2 id="home-articles-title">Latest articles</h2>
          <a href="/articles">View all</a>
        </header>
        <div class="home-article-grid">
          {homepageArticles.map((article) => <ArticleRow article={article} />)}
        </div>
      </section>

      <section class="home-section home-domains" aria-labelledby="home-domains-title">
        <header class="home-section__header">
          <h2 id="home-domains-title">Study domains</h2>
          <a href="/domains">View all</a>
        </header>
        <div class="domain-grid home-domain-grid">
          {homepageDomains.map((domain) => <DomainCard domain={domain} />)}
        </div>
      </section>

      <section class="home-section" aria-labelledby="home-more-articles-title">
        <header class="home-section__header">
          <h2 id="home-more-articles-title">More articles</h2>
          <a href="/articles">View all</a>
        </header>
        <div class="home-article-grid">
          {moreHomepageArticles.map((article) => <ArticleRow article={article} />)}
        </div>
      </section>
    </div>
  </main>

  <script>
    const homepageVideo = document.querySelector<HTMLVideoElement>("[data-homepage-video]");
    if (homepageVideo) homepageVideo.playbackRate = 0.75;
  </script>
</BaseLayout>
