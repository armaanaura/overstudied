---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About Us" description="About Overstudied and its authors, Armaandeep Singh and Vanshika Chawala.">
  <main id="main-content" class="page-shell about-page">
    <header class="page-intro section-intro">
      <p class="page-kicker">About us</p>
      <h1>Learning in public, one difficult idea at a time.</h1>
      <p>Overstudied turns ongoing study into clear articles about technology, science, psychology, and the ideas connecting them.</p>
    </header>

    <div class="about-sections">
      <section>
        <h2>About Overstudied</h2>
        <p>
          Overstudied was created to publish what we learn and stay motivated to keep studying.
          It covers quantum physics and computing, data structures and algorithms, artificial
          intelligence, research papers, psychology, and complex systems. The goal is to make
          careful learning useful to anyone who wants to understand a subject more deeply.
        </p>
      </section>

      <section id="armaandeep-singh">
        <p class="page-kicker">Founder and author</p>
        <h2>Armaandeep Singh</h2>
        <p>
          Software developer with experience in machine learning, MLOps, Databricks, and
          generative AI, with a strong interest in quantum computing and complex technical
          systems.
        </p>
        <a class="text-link" href="https://in.linkedin.com/in/armaanaura" target="_blank" rel="noreferrer">
          Connect with Armaandeep on LinkedIn
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </section>

      <section id="vanshika-chawala">
        <p class="page-kicker">Psychology author</p>
        <h2>Vanshika Chawala</h2>
        <p>
          Vanshika is responsible for Overstudied's psychology content, exploring human
          behavior, learning, memory, decision-making, and the research that helps us
          understand how people think.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
