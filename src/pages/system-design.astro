---
import ArchitectureRow from "../components/ArchitectureRow.astro";
import ArticleRow from "../components/ArticleRow.astro";
import SearchBox from "../components/SearchBox.astro";
import { architectures } from "../data/architectures";
import { articles } from "../data/articles";
import BaseLayout from "../layouts/BaseLayout.astro";

const systemDesignContent = [
  ...articles
    .filter((article) => article.category === "system-design")
    .map((item) => ({ date: item.date, kind: "article" as const, item })),
  ...architectures.map((item) => ({ date: item.date, kind: "explainer" as const, item })),
].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title="System Design" description="End-to-end system design explainers from Overstudied.">
  <main id="main-content" class="page-shell">
    <header class="page-intro section-intro">
      <p class="page-kicker">System Design</p>
      <h1>Large systems, explained end to end.</h1>
      <p>Breakdowns that connect components, tradeoffs, failure modes, and operating reality.</p>
      <div class="page-search">
        <SearchBox id="content-search" placeholder="Search system designs" />
      </div>
    </header>
    <div class="section-divider" aria-hidden="true"></div>
    <section class="article-list" aria-label="System design explainers">
      {systemDesignContent.map((entry) => (
        entry.kind === "article"
          ? <ArticleRow article={entry.item} />
          : <ArchitectureRow architecture={entry.item} />
      ))}
    </section>
    <p class="empty-state" data-search-empty hidden>No system designs match this search.</p>
  </main>
</BaseLayout>
