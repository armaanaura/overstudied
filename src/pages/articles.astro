---
import ArchitectureRow from "../components/ArchitectureRow.astro";
import ArticleRow from "../components/ArticleRow.astro";
import SearchBox from "../components/SearchBox.astro";
import TopicTabs from "../components/TopicTabs.astro";
import { architectures } from "../data/architectures";
import { articles } from "../data/articles";
import { domains } from "../data/domains";
import BaseLayout from "../layouts/BaseLayout.astro";

const categoryTabs = [
  { label: "All", value: "latest" },
  ...domains.map((domain) => ({
    label: domain.slug === "dsa" ? "DSA" : domain.name,
    value: domain.slug,
  })),
];

const allArticles = [
  ...articles.map((item) => ({ date: item.date, kind: "article" as const, item })),
  ...architectures.map((item) => ({ date: item.date, kind: "system-design" as const, item })),
].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title="Articles" description="Overstudied articles organized by study domain and ordered by date.">
  <main id="main-content" class="page-shell">
    <header class="page-intro section-intro">
      <p class="page-kicker">Articles</p>
      <h1>Articles, organized by domain.</h1>
      <p>Explore system design, quantum computing, psychology, and data structures and algorithms.</p>
      <div class="page-search">
        <SearchBox id="content-search" placeholder="Search articles" />
      </div>
    </header>
    <TopicTabs
      items={categoryTabs}
      current="latest"
      label="Article categories"
      interactive
    />
    <section class="article-list" aria-label="All articles">
      {allArticles.map((entry) => (
        entry.kind === "article"
          ? <ArticleRow article={entry.item} />
          : <ArchitectureRow architecture={entry.item} />
      ))}
    </section>
    <p class="empty-state" data-search-empty hidden>No articles match this search.</p>
  </main>
</BaseLayout>
