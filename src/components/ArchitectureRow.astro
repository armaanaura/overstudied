---
import type { Architecture } from "../data/types";
import { getArticleThumbnail } from "../lib/article-images";
import { formatShortDate } from "../lib/format";
import TagChip from "./TagChip.astro";

interface Props {
  architecture: Architecture;
}

const { architecture } = Astro.props;
const thumbnail = getArticleThumbnail(architecture.image, architecture.slug);
const searchText = [
  architecture.title,
  architecture.excerpt,
  architecture.tags.join(" "),
  architecture.systemsCovered.join(" "),
  architecture.complexity,
].join(" ").toLowerCase();
---

<article
  class="article-row architecture-row searchable-item"
  id={architecture.slug}
  data-searchable={searchText}
  data-feed-type="architecture"
  data-category={architecture.category}
>
  <div class="article-row__thumbnail" aria-hidden={thumbnail ? undefined : "true"}>
    {thumbnail && <img src={thumbnail.src} alt={thumbnail.alt} loading="lazy" />}
  </div>
  <div class="article-row__copy">
    <p class="byline">
      Armaandeep Singh
      <span class="byline__category"><span aria-hidden="true">·</span> System Design</span>
    </p>
    <h2><a href={`/system-design#${architecture.slug}`}>{architecture.title}</a></h2>
    <p class="article-row__excerpt">{architecture.excerpt}</p>
    <div class="article-row__meta">
      <TagChip label={architecture.tags[0]} />
      <span>Posted on {formatShortDate(architecture.date)}</span>
      <span>.</span>
      <span>{architecture.readTime}</span>
    </div>
  </div>
</article>
