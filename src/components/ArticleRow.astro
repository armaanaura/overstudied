---
import type { Article } from "../data/types";
import { domains } from "../data/domains";
import { getArticleThumbnail } from "../lib/article-images";
import { formatShortDate } from "../lib/format";
import TagChip from "./TagChip.astro";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const thumbnail = getArticleThumbnail(article.image, article.slug);
const categoryName = domains.find((domain) => domain.slug === article.category)?.name;
const searchText = [article.title, article.excerpt, article.tags.join(" "), article.category]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<article
  class="article-row searchable-item"
  id={article.slug}
  data-searchable={searchText}
  data-feed-type="article"
  data-category={article.category}
>
  <div class="article-row__thumbnail" aria-hidden={thumbnail ? undefined : "true"}>
    {thumbnail && <img src={thumbnail.src} alt={thumbnail.alt} loading="lazy" />}
  </div>
  <div class="article-row__copy">
    <p class="byline">
      Armaandeep Singh
      {categoryName && (
        <span class="byline__category"><span aria-hidden="true">·</span> {categoryName}</span>
      )}
    </p>
    <h2><a href={`/articles/${article.slug}`}>{article.title}</a></h2>
    <p class="article-row__excerpt">{article.excerpt}</p>
    <div class="article-row__meta">
      <TagChip label={article.tags[0]} />
      <span>Posted on {formatShortDate(article.date)}</span>
      <span>.</span>
      <span>{article.readTime}</span>
    </div>
  </div>
</article>
