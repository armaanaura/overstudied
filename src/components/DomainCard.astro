---
import type { StudyDomain } from "../data/types";
import { getDomainThumbnail } from "../lib/article-images";

interface Props {
  domain: StudyDomain;
}

const { domain } = Astro.props;
const thumbnail = getDomainThumbnail(domain.image, domain.slug, domain.name);
const searchText = `${domain.name} ${domain.tagline}`.toLowerCase();
---

<article
  class="domain-card searchable-item"
  data-searchable={searchText}
  data-feed-type="domain"
>
  <a class="domain-card__link" href={`/domains/${domain.slug}`}>
    <div class="domain-card__thumbnail">
      {thumbnail && <img src={thumbnail.src} alt={thumbnail.alt} loading="lazy" />}
    </div>
    <div class="domain-card__copy">
      <h2>{domain.name}</h2>
      <p class="domain-card__tagline">{domain.tagline}</p>
    </div>
  </a>
</article>
